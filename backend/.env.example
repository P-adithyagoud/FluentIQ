# AI English Learning Platform - Environment Configurations
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security (Change in production!)
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-12345
SECRET_KEY=super-secret-session-key-change-in-production-12345

# Database Configuration
# Fallback to SQLite (sqlite:///app.db) if empty, or provide your Supabase PostgreSQL URI:
# Format: postgresql://postgres.[username]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///app.db
